% quantbook.sty: house style for the book.
% Layout ideas follow dspinellis/latex-advice (symbolic references, no explicit formatting,
% booktabs tables, siunitx numbers) and Wookai/paper-tips-and-tricks (macros for notation,
% one script per data-driven figure, vector figures).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{quantbook}[2026/10/19 house style]

% ---------------------------------------------------------------- fonts and page
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sc]{mathpazo}
\linespread{1.06}
\RequirePackage[letterpaper,inner=1.15in,outer=1.15in,top=1.05in,bottom=1.1in,headheight=14pt]{geometry}
\RequirePackage{microtype}
\RequirePackage[english]{babel}
\RequirePackage{csquotes}

% ---------------------------------------------------------------- colour
\RequirePackage[dvipsnames]{xcolor}
\definecolor{qbblue}{HTML}{011F5B}
\definecolor{qbred}{HTML}{990000}
\definecolor{qbgrey}{HTML}{5F6368}
\definecolor{qbpale}{HTML}{EEF2F8}

% ---------------------------------------------------------------- mathematics
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage{amsthm}
\RequirePackage{siunitx}
\sisetup{group-separator={,},group-minimum-digits=4}
\newcommand{\E}{\mathbb{E}}
\newcommand{\Var}{\operatorname{Var}}
\newcommand{\Cov}{\operatorname{Cov}}
\newcommand{\Corr}{\operatorname{Corr}}
\newcommand{\NPV}{\operatorname{NPV}}
\newcommand{\IRR}{\mathrm{IRR}}
\newcommand{\MIRR}{\mathrm{MIRR}}
\newcommand{\dd}{\,\mathrm{d}}
\newcommand{\N}{\mathcal{N}}
\newcommand{\pct}[1]{#1\%}

% ---------------------------------------------------------------- figures and tables
\RequirePackage{graphicx}
\graphicspath{{figures/}}
\DeclareGraphicsExtensions{.png}   % figures are PNG at 300 dpi; no PDF files live in the repository
\RequirePackage{booktabs,array,tabularx,longtable}
\RequirePackage[font=small,labelfont={bf,color=qbblue},labelsep=period,format=hang]{caption}
\RequirePackage{float}
\RequirePackage{placeins}

% ---------------------------------------------------------------- headings
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\color{qbblue}}
  {\scshape\large\color{qbred}Chapter \thechapter}
  {6pt}
  {\Huge}
  [\vspace{4pt}{\color{qbred}\titlerule[0.8pt]}]
\titlespacing*{\chapter}{0pt}{20pt}{28pt}
\titleformat{\section}{\normalfont\Large\color{qbblue}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalfont\large\itshape\color{qbblue}}{\thesubsection}{0.8em}{}
\titleformat{\paragraph}[runin]{\normalfont\bfseries\color{qbblue}}{}{0pt}{}[\@addpunct{.}]

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\color{qbgrey}\thepage\quad\scshape\leftmark}
\fancyhead[RO]{\small\color{qbgrey}\scshape\rightmark\quad\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{Chapter \thechapter\quad #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\color{qbgrey}\thepage}}

% ---------------------------------------------------------------- boxes
\RequirePackage[most]{tcolorbox}
\newtcolorbox{keybox}[1][]{enhanced,breakable,colback=qbpale,colframe=qbblue,boxrule=0pt,
  leftrule=2pt,arc=0pt,left=8pt,right=8pt,top=6pt,bottom=6pt,fonttitle=\bfseries\color{qbblue},
  coltitle=qbblue,colbacktitle=qbpale,title={#1},attach title to upper={\quad}}
\newcounter{example}[chapter]
\renewcommand{\theexample}{\thechapter.\arabic{example}}
\newenvironment{example}[1]{%
  \refstepcounter{example}%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=qbred,boxrule=0pt,leftrule=1.6pt,
    arc=0pt,left=8pt,right=6pt,top=4pt,bottom=4pt]%
  {\color{qbred}\bfseries Example \theexample\quad}{\itshape #1.}\par\smallskip}%
  {\end{tcolorbox}}

% ---------------------------------------------------------------- code
\RequirePackage{listings}
\RequirePackage{needspace}
\lstdefinestyle{qb}{basicstyle=\ttfamily\footnotesize,keywordstyle=\color{qbblue}\bfseries,
  commentstyle=\color{qbgrey}\itshape,stringstyle=\color{qbred},showstringspaces=false,
  frame=leftline,framerule=1.2pt,rulecolor=\color{qbblue},xleftmargin=10pt,framexleftmargin=6pt,
  columns=fullflexible,keepspaces=true,breaklines=true,upquote=true,aboveskip=8pt,belowskip=6pt}
\lstset{style=qb}

% ---------------------------------------------------------------- lists, references, links
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=4pt}
\RequirePackage[backend=biber,style=authoryear,maxcitenames=2,maxbibnames=10,uniquename=false,
  uniquelist=false,dashed=false,giveninits=true,doi=true,url=true,isbn=false]{biblatex}
\RequirePackage{imakeidx}
\makeindex[intoc,columns=2,title=Index]

\newcommand{\ix}[1]{\index{#1}}  % index entries placed by scripts/add_index.py
% the kind of a result in the applied chapters: exact (closed form), simulation, or historical
\newcommand{\kind}[1]{\textsf{\small[#1]}}
\RequirePackage[colorlinks=true,linkcolor=qbblue,citecolor=qbblue,urlcolor=qbred,
  pdfcreator={},pdfproducer={},pdfauthor={John Khan},pdftitle={},pdfsubject={},pdfkeywords={}]{hyperref}
\setcounter{biburllcpenalty}{7000}
\setcounter{biburlucpenalty}{8000}
\setcounter{biburlnumpenalty}{9000}
\RequirePackage[capitalise,noabbrev]{cleveref}
% One reference list for the whole book. A chapter built on its own (\chapteronly) keeps its own list.
\newenvironment{chapterrefs}{\ifdefined\chapteronly\begin{refsection}\fi}{\ifdefined\chapteronly
  {\emergencystretch=2em\printbibliography[heading=subbibliography,title={References for Chapter \thechapter}]}%
  \end{refsection}\fi}
\crefname{example}{Example}{Examples}
% the only labelled list items in the book are exercises
\crefname{enumi}{Exercise}{Exercises}\Crefname{enumi}{Exercise}{Exercises}
\creflabelformat{equation}{#2(#1)#3}

% theorem environments share one counter through aliascnt so cleveref names each type correctly
\theoremstyle{definition}
\newtheorem{definition}{Definition}[chapter]
\RequirePackage{aliascnt}
\newcommand{\qbtheorem}[2]{%
  \newaliascnt{#1}{definition}\newtheorem{#1}[#1]{#2}\aliascntresetthe{#1}%
  \crefname{#1}{#2}{#2s}\Crefname{#1}{#2}{#2s}}
\qbtheorem{proposition}{Proposition}
\qbtheorem{theorem}{Theorem}
\qbtheorem{lemma}{Lemma}
\qbtheorem{corollary}{Corollary}
\crefname{definition}{Definition}{Definitions}
\theoremstyle{remark}
\newtheorem*{remark}{Remark}


% ---------------------------------------------------------------- PDF hygiene (pdfTeX)
\ifdefined\pdfinfoomitdate
  \pdfinfoomitdate=1
  \pdftrailerid{}
  \pdfsuppressptexinfo=-1
\fi

% ---------------------------------------------------------------- review copy hook
% \pid{ID} marks a scorable unit in the review build; main.tex defines it (empty in the reading copy).
\setlength{\emergencystretch}{3em}
\endinput
